# ---- Root example env (see backend/.env.example and frontend/.env.example) ----

# PostgreSQL (matches docker-compose.yml)
DATABASE_URL="postgresql://throttlex:throttlex@localhost:5432/throttlex?schema=public"

# Redis
REDIS_URL="redis://localhost:6379"

# Backend
PORT=4000
NODE_ENV=development
JWT_SECRET="change-me-in-production"
JWT_EXPIRES_IN="7d"
CORS_ORIGIN="http://localhost:3000"

# Rate limiter behaviour: fail-open = allow traffic if Redis is down (availability first)
RATE_LIMIT_FAIL_OPEN=true

# Seed admin credentials
SEED_ADMIN_EMAIL="admin@throttlex.dev"
SEED_ADMIN_PASSWORD="admin123"

# Frontend
NEXT_PUBLIC_API_URL="http://localhost:4000"
